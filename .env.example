# Flipit SPV Investor Portal — environment configuration
#
# Copy to .env and fill in. The application validates every variable at boot
# and refuses to start if one is missing or malformed (src/lib/env.ts).

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/spv"

# ---------------------------------------------------------------------------
# Deployment identity
# ---------------------------------------------------------------------------

# Path prefix the app is served under. Empty for a domain root.
#   Testing:    "/SPV"        (served at mikehelm.com/SPV)
#   Production: ""            (served at spv.flipit.com)
BASE_PATH=""

# Absolute public URL of THIS deployment, including any base path.
# Portal links embed this value.
#   Testing:    "https://mikehelm.com/SPV"
#   Production: "https://spv.flipit.com"
APP_URL="http://localhost:3000"

# The one APP_URL permitted to send real invitations. When APP_URL does not
# match this, sending is refused — see BUILD_SPEC §18.1.
#
# Every portal link embeds the domain it was issued from. A link issued by the
# testing deployment dies the moment the app moves, leaving an investor holding
# a dead link to a securities offer. Hence the guard.
PRODUCTION_APP_URL="https://spv.flipit.com"

# ---------------------------------------------------------------------------
# The origin a browser actually reaches — optional
# ---------------------------------------------------------------------------
#
# Set this when the address the world uses is NOT the same as APP_URL. The
# ordinary case for that is the pre-launch state this application is designed
# for: served publicly over HTTPS while APP_URL is deliberately still
# http://localhost:3000 so that the §18.1 send guard refuses.
#
#   ""                          the same as APP_URL. Correct for local
#                               development and for a live deployment where the
#                               two already agree.
#   "https://spv.flipit.ltd"    served there, but not yet cleared to send.
#
# It decides two things and NOT a third:
#
#   - whether session cookies carry `Secure`. This is why the variable exists.
#     Deriving it from APP_URL meant an administrator's session cookie was
#     issued without `Secure` behind an HTTPS tunnel, and would be sent in the
#     clear on any http:// request before Cloudflare's redirect.
#   - what robots.txt and sitemap.xml publish, since a crawler fetches those
#     from the public hostname.
#
# It does NOT decide whether real invitations may be sent. That is APP_URL
# against PRODUCTION_APP_URL, unchanged, and setting this cannot unlock it.
PUBLIC_ORIGIN=""
#
# IMPORTANT: this one has to be set when you run `pnpm build`, not only when you
# run `pnpm start`. Next evaluates the header rules in next.config.ts at build
# time and bakes them into .next/routes-manifest.json, so HSTS is decided there
# and a value supplied only at runtime never reaches it. The Secure cookie and
# the sitemap DO read it at runtime. Set it in .env and both are covered.

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# 32 bytes, base64 encoded. Encrypts the SMTP app password, the OpenAI key and
# other sensitive fields at rest. Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=""

# Auth.js session secret. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# The health endpoint — optional
# ---------------------------------------------------------------------------
#
# The shared secret an external uptime monitor presents to GET /api/health.
#
#   ""    the endpoint does not exist. Every request to it, with or without a
#         header, gets the same empty 404 as any invented path. This is the
#         default and it is a supported state.
#   set   the endpoint answers 200 when nothing needs a person and 503 when
#         something does, to a request carrying
#
#             x-health-token: <this value>
#
#         A header, never a query string: a query string is written to every
#         access log between the monitor and here.
#
# Point an uptime monitor at it and the monitor pages somebody on the 503. That
# is the only signal in this system that survives the machine itself stopping —
# `pnpm check:health` runs on the box it is watching, and a box that is down
# reports nothing. Nothing here sends: the reminder job stays the only
# unattended sender in the application.
#
# At least 32 characters, or the app refuses to start. Generate with:
#   openssl rand -base64 32
HEALTH_TOKEN=""

# ---------------------------------------------------------------------------
# Sign-in
# ---------------------------------------------------------------------------
#
# There is nothing to configure. The owner and operator sign in with an email
# and password held in this application's own database — no Google Cloud
# project, no OAuth client, no consent screen (BUILD_SPEC §2.2).
#
# On first run the seed prints a one-time setup link to the console. Open it and
# choose a password. A password is never read from this file.

# ---------------------------------------------------------------------------
# Role allowlist
# ---------------------------------------------------------------------------
#
# Role is assigned by email address. A sign-in attempt from an address on
# neither list, and holding no investor account, is rejected outright — no
# record is created. BUILD_SPEC §2.

OWNER_EMAILS="mike@flipthepage.com,mike@flipit.com"
OPERATOR_EMAILS="serenedavid@gmail.com"

# Read-only administrators. A viewer sees every investor record, the four
# amounts, the documents and the conversation — and can change none of it.
# They cannot reach the audit log, the export, the compliance approval,
# settings, the import, or the register's order.
#
# Empty is the ordinary state. Adding an address here grants sight of every
# named investor's financial position, so it is a decision rather than a
# configuration step.
VIEWER_EMAILS=""

# ---------------------------------------------------------------------------
# Media storage — BUILD_SPEC §13.2, §13.3
# ---------------------------------------------------------------------------

# Where uploaded images and David's personal video are stored.
#
#   ""             nowhere. Uploads are refused with a message saying what to
#                  set. This is a SUPPORTED state, not a broken one: the
#                  portal, the invitation and the participation certificate
#                  are all complete with an empty media library.
#   "filesystem"   a directory on this machine. Needs a disk that survives a
#                  restart — a serverless deployment does not have one, which
#                  is why this is a choice and not a default.
#   "object-store" selectable, and not yet wired up. Choosing it produces a
#                  an S3-compatible bucket. This is the one to use on any
#                  deployment without a disk that survives a restart, which is
#                  every serverless one. Configure the five variables below.
MEDIA_STORE=""

# Directory for MEDIA_STORE="filesystem". Ignored otherwise.
MEDIA_DIR=".media"

# ---------------------------------------------------------------------------
# Object store — required when, and only when, MEDIA_STORE="object-store"
# ---------------------------------------------------------------------------
#
# Any S3-compatible endpoint: AWS S3, Cloudflare R2, Backblaze B2, MinIO. The
# address is built as ENDPOINT/BUCKET/KEY (path style), so the endpoint must be
# scheme and host with no path — the app refuses to start otherwise.
#
# Selecting the object store with only some of these set is a refusal to start,
# not an app that runs, looks configured, and fails on the first upload.
#
#   AWS     MEDIA_S3_ENDPOINT="https://s3.eu-west-2.amazonaws.com"  REGION="eu-west-2"
#   R2      MEDIA_S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"  REGION="auto"
#   MinIO   MEDIA_S3_ENDPOINT="http://minio.internal:9000"  REGION= anything, consistently
#
# The bucket MUST be private. Nothing in this application makes an object
# public, and every byte an investor reads is served through a route that
# checks the session first. A public bucket would put a document package on the
# open internet behind nothing but an unguessable name.
#
# The bucket MUST NOT be versioned, and must carry no object lock or retention
# policy. With versioning on, a delete writes a marker and keeps the object —
# and an investor erasure would report success while every byte remained
# recoverable. See DEPLOYMENT.md §1.
MEDIA_S3_ENDPOINT=""
MEDIA_S3_REGION="auto"
MEDIA_S3_BUCKET=""

# The key pair. Scope it to this one bucket, with put, get and delete and
# nothing else. Neither is ever logged or returned to a browser.
MEDIA_S3_ACCESS_KEY_ID=""
MEDIA_S3_SECRET_ACCESS_KEY=""
