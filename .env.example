# Flipit SPV Investor Portal — environment configuration
#
# Copy to .env and fill in. The application validates every variable at boot
# and refuses to start if one is missing or malformed (src/lib/env.ts).

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/spv"

# ---------------------------------------------------------------------------
# Deployment identity
# ---------------------------------------------------------------------------

# Path prefix the app is served under. Empty for a domain root.
#   Testing:    "/SPV"        (served at mikehelm.com/SPV)
#   Production: ""            (served at spv.flipit.com)
BASE_PATH=""

# Absolute public URL of THIS deployment, including any base path.
# Portal links embed this value.
#   Testing:    "https://mikehelm.com/SPV"
#   Production: "https://spv.flipit.com"
APP_URL="http://localhost:3000"

# The one APP_URL permitted to send real invitations. When APP_URL does not
# match this, sending is refused — see BUILD_SPEC §18.1.
#
# Every portal link embeds the domain it was issued from. A link issued by the
# testing deployment dies the moment the app moves, leaving an investor holding
# a dead link to a securities offer. Hence the guard.
PRODUCTION_APP_URL="https://spv.flipit.com"

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# 32 bytes, base64 encoded. Encrypts the SMTP app password, the OpenAI key and
# other sensitive fields at rest. Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=""

# Auth.js session secret. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Google sign-in (owner and operator only — never for investors)
# ---------------------------------------------------------------------------
#
# This is plain sign-in: name, email and profile. It is NOT a Gmail scope and
# needs no Google verification. Mail is sent over SMTP with an app password
# (BUILD_SPEC §8.1).

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Role allowlist
# ---------------------------------------------------------------------------
#
# Role is assigned by email address. A Google sign-in from an address on
# neither list, and holding no investor account, is rejected outright — no
# record is created. BUILD_SPEC §2.

OWNER_EMAILS="mike@flipthepage.com,mike@flipit.com"
OPERATOR_EMAILS="serenedavid@gmail.com"
